# Bring-up fallback only. Prefer IDpuLabVendorService in production.
# Values must be readable under both DAC and SELinux policy.

gpu_busy=/sys/vendor/path/to/gpu_busy
gpu_frequency=/sys/vendor/path/to/gpu_cur_freq
bus_busy=/sys/vendor/path/to/ddr_busy
dpu_busy=/sys/vendor/path/to/dpu_active_percent
dpu_underrun=/sys/vendor/path/to/dpu_underrun_count
